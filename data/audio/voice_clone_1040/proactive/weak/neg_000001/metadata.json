      "metadata": {
        "phase": "none"
      },
      "file": "chunk_003.pcm",
      "size_bytes": 620844
    },
    {
      "index": 4,
      "text": "I remember the address because it sounded so specific: Room 199, Building B, East District. They also called 13891030736 before arriving.",
